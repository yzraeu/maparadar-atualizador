{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atualizador MapaRadar",
  "version": "0.2.6",
  "identifier": "com.maparadar.atualizador",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Atualizador MapaRadar",
        "width": 560,
        "height": 820,
        "maximizable": false,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.maparadar.com https://github.com https://objects.githubusercontent.com https://github-releases.githubusercontent.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420 https://api.maparadar.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "MapaRadar",
    "homepage": "https://maparadar.com/atualizador.html",
    "category": "Utility",
    "shortDescription": "Atualizador MapaRadar para GPS iGO8 e NDrive",
    "longDescription": "Aplicativo desktop oficial da MapaRadar para atualizar automaticamente a base de radares no seu GPS.",
    "license": "Proprietary",
    "licenseFile": "LICENSE.txt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/share/metainfo/com.maparadar.atualizador.metainfo.xml": "com.maparadar.atualizador.metainfo.xml"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/metainfo/com.maparadar.atualizador.metainfo.xml": "com.maparadar.atualizador.metainfo.xml"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/metainfo/com.maparadar.atualizador.metainfo.xml": "com.maparadar.atualizador.metainfo.xml"
        },
        "desktopTemplate": "rpm.desktop.template"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2OTVEMTc3QURGQ0FCNkEKUldScXEveXRkOUdWeGtvUW9FaXpSZEhiTjk4Sko0T2VWaWloaWJ5MmxaRFh1TEJYM0dqTXlEZ0wK",
      "endpoints": [
        "https://github.com/yzraeu/maparadar-atualizador/releases/latest/download/latest.json"
      ]
    }
  }
}
